# Postgres connection string. Locally: a free Neon/Vercel Postgres database
# works fine for dev too. In production (Vercel): set this in your Vercel
# project's Environment Variables — SQLite cannot run on Vercel's serverless
# functions (no persistent filesystem), which is why this isn't a local
# file path.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Generate a real secret for any non-local environment, e.g.:
#   openssl rand -base64 32
AUTH_SECRET="dev-only-insecure-secret-change-in-production-0123456789"
# Local dev: http://localhost:3000 — in Vercel, set this to your deployed
# URL (e.g. https://your-project.vercel.app).
NEXTAUTH_URL="http://localhost:3000"

# Programme defaults (also stored in ProgrammeSetting table so they can be
# changed at runtime without a redeploy — these are just the seed values)
DEFAULT_MONTHLY_AMOUNT=50
DEFAULT_CURRENCY=USD
DEFAULT_DISTRIBUTION_FREQUENCY_MONTHS=3
DEFAULT_REPORTING_CYCLE_MONTHS=3
DEFAULT_MEETING_CYCLE_MONTHS=6
